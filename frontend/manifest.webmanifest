{
  "name": "Mkulima Sokoni",
  "short_name": "Mkulima",
  "description": "Buy fresh farm produce directly from Kenyan farmers and agro-dealers.",
  "id": "/?source=pwa",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#FAF6EF",
  "theme_color": "#1B4332",
  "lang": "en-KE",
  "dir": "ltr",
  "categories": ["business", "shopping", "food", "agriculture"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/assets/img/logo.jpeg", "sizes": "192x192", "type": "image/jpeg", "purpose": "any" },
    { "src": "/assets/img/logo.jpeg", "sizes": "512x512", "type": "image/jpeg", "purpose": "any" },
    { "src": "/assets/img/logo.jpeg", "sizes": "192x192", "type": "image/jpeg", "purpose": "maskable" },
    { "src": "/assets/img/logo.jpeg", "sizes": "512x512", "type": "image/jpeg", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Marketplace", "short_name": "Market", "url": "/market", "description": "Browse fresh produce from farmers." },
    { "name": "Sell on Mkulima Sokoni", "short_name": "Sell", "url": "/auth?next=farmer", "description": "Sign in as a farmer to list your produce." },
    { "name": "My Dashboard", "short_name": "Dashboard", "url": "/auth", "description": "Sign in to your account." }
  ],
  "share_target": {
    "action": "/market",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  }
}
